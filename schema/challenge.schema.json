{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nvim-skill-arcade community challenge",
  "description": "Editor hint only. The authoritative check is lua/skill_arcade/schema.lua in nvim-skill-arcade plus the CI replay.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "area", "level", "brief", "text", "solution", "why"],
  "anyOf": [{ "required": ["expect"] }, { "required": ["track"] }],
  "$defs": {
    "tsObjRange": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 4,
      "maxItems": 4,
      "description": "[startLine (1-based), startCol (0-based), endLine (1-based), endCol (0-based exclusive)]"
    },
    "tsObjEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inner", "outer"],
      "properties": {
        "inner": { "$ref": "#/$defs/tsObjRange" },
        "outer": { "$ref": "#/$defs/tsObjRange" }
      }
    },
    "tsObjList": {
      "type": "array",
      "items": { "$ref": "#/$defs/tsObjEntry" }
    }
  },
  "properties": {
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal"],
      "description": "area \"track\": the text is a grid map; reach goal, touching checkpoints in order. expect is derived (cursor on goal, text unchanged) and may be left out. ASCII map only.",
      "properties": {
        "goal": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2, "description": "[row (1-based), col (0-based)]" },
        "checkpoints": {
          "type": "array",
          "maxItems": 6,
          "items": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 },
          "description": "cells to touch in this order; distinct, never the goal"
        },
        "forbid": { "type": "array", "uniqueItems": true, "items": { "enum": ["hjkl", "arrows", "mouse"] } }
      }
    },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 40, "description": "must equal the file name without .json" },
    "title": { "type": "string", "maxLength": 60 },
    "area": { "enum": ["motions", "textobjects", "editing", "search", "macros", "registers", "marks", "windows", "quickfix", "diagnostics", "track", "refactor", "plugins"] },
    "level": { "type": "integer", "minimum": 1, "maximum": 5 },
    "brief": { "type": "string", "maxLength": 240, "description": "the END STATE to reach, never the keys" },
    "text": { "type": "string", "maxLength": 2000, "description": "start buffer, at most 40 lines" },
    "cursor": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1, "maxItems": 2, "description": "[row (1-based), col (0-based)]" },
    "ft": { "enum": ["text", "lua", "python", "javascript", "typescript", "go", "cs", "markdown", "json", "html"] },
    "loose": { "type": "boolean", "description": "ignore leading whitespace when comparing text" },
    "solution": { "type": "string", "maxLength": 120, "description": "reference keys in Vim notation; replayed by CI; limited ex commands" },
    "why": { "type": "string", "maxLength": 300 },
    "hint": { "type": "string", "maxLength": 120 },
    "author": { "type": "string", "maxLength": 40 },
    "par_seconds": { "type": "integer", "minimum": 3, "maximum": 120 },
    "plugin_par": { "type": "integer", "minimum": 1, "maximum": 50 },
    "needs": { "enum": ["jump", "surround", "textobjects", "comment", "picker", "keyhints", "files", "bookmarks", "trouble", "replace", "multicursor", "move", "treesitter", "whichkey", "lsp"] },
    "which_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefixes"],
      "description": "Which-key prefix hint overlay configuration for this challenge",
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 200, "maximum": 3000, "description": "Delay before showing the overlay (ms)" },
        "prefixes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trigger", "entries"],
            "properties": {
              "trigger": { "type": "string", "minLength": 1, "maxLength": 10, "description": "The prefix key(s) that activate this group" },
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["key", "label"],
                  "properties": {
                    "key": { "type": "string", "minLength": 1, "maxLength": 10 },
                    "label": { "type": "string", "minLength": 1, "maxLength": 60 },
                    "group": { "type": "string", "maxLength": 30 }
                  }
                }
              },
              "children": {
                "type": "array",
                "items": { "$ref": "#/properties/which_key/properties/prefixes/items" }
              }
            }
          }
        }
      }
    },
    "jump_targets": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "row", "col"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 2 },
          "row": { "type": "integer", "minimum": 0 },
          "col": { "type": "integer", "minimum": 0 }
        }
      },
      "description": "Pre-computed jump targets for label-based motion simulation"
    },
"picker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "type": { "enum": ["find_files", "grep", "buffers"] },
        "prompt": { "type": "string", "maxLength": 60 },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 120 },
              "line": { "type": "integer", "minimum": 1 },
              "content": { "type": "string", "maxLength": 200 }
            }
          }
        },
        "expect_selection": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "maxLength": 120 }]
        }
      },
      "description": "Picker (Telescope/fzf) simulation: items to show and which one is expected"
    },
    "harpoon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slots"],
      "description": "Harpoon-style named slot navigation: each slot is a buffer the player can save and jump to.",
      "properties": {
        "slots": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-d]$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": { "type": "string", "maxLength": 2000 },
              "cursor": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1, "maxItems": 2 },
              "ft": { "enum": ["text", "lua", "python", "javascript", "typescript", "go", "cs", "markdown", "json", "html"] }
            }
          }
        },
        "sequence": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-d]$" },
          "description": "Expected visit order of slot names for checkpoint judging."
        }
      }
    },
"treesitter_objects": {
      "type": "object",
      "additionalProperties": false,
      "description": "Pre-computed treesitter text objects for structural editing (function, class, statement, parameter, block, tag).",
      "properties": {
        "function": { "$ref": "#/$defs/tsObjList" },
        "class": { "$ref": "#/$defs/tsObjList" },
        "statement": { "$ref": "#/$defs/tsObjList" },
        "parameter": { "$ref": "#/$defs/tsObjList" },
        "block": { "$ref": "#/$defs/tsObjList" },
        "tag": { "$ref": "#/$defs/tsObjList" }
      }
    },
    "lsp": {
      "type": "object",
      "additionalProperties": false,
      "description": "LSP simulation: scripted hover, go-to-definition and diagnostics (no completion).",
      "properties": {
        "hover": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["row", "col", "text"],
            "properties": {
              "row": { "type": "integer", "minimum": 1 },
              "col": { "type": "integer", "minimum": 0 },
              "end_col": { "type": "integer", "minimum": 0 },
              "text": { "type": "string", "maxLength": 500 }
            }
          }
        },
        "definition": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["row", "col", "target_row", "target_col"],
            "properties": {
              "row": { "type": "integer", "minimum": 1 },
              "col": { "type": "integer", "minimum": 0 },
              "end_col": { "type": "integer", "minimum": 0 },
              "target_row": { "type": "integer", "minimum": 1 },
              "target_col": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["row", "col", "end_col", "severity"],
            "properties": {
              "row": { "type": "integer", "minimum": 1 },
              "col": { "type": "integer", "minimum": 0 },
              "end_col": { "type": "integer", "minimum": 0 },
              "severity": { "enum": ["error", "warning", "info", "hint"] },
              "message": { "type": "string", "maxLength": 300 }
            }
          }
        }
      }
    },
    "helps": { "type": "object", "maxProperties": 13, "additionalProperties": { "type": "string", "maxLength": 200 } },
    "preset": { "enum": ["diagnostics", "splits", "alt_buffer", "quickfix_hits"] },
    "preset_rows": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "maxItems": 10 },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "text": { "type": "string", "maxLength": 2000 },
        "cursor": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1, "maxItems": 2 },
        "at": { "type": "array", "prefixItems": [{ "type": "integer" }, { "type": "string", "maxLength": 60 }, { "enum": ["first", "last"] }], "minItems": 2, "maxItems": 3 },
        "marks": { "type": "object", "propertyNames": { "pattern": "^[a-z]$" }, "additionalProperties": { "type": "integer" } },
        "windows": { "type": "integer", "minimum": 1, "maximum": 6 },
        "layout": { "enum": ["row", "col"] },
        "extra_tabs": { "type": "integer", "minimum": 0, "maximum": 3 },
        "quickfix": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "idx": { "type": "integer" }, "size": { "type": "integer" }, "all_contain": { "type": "string", "maxLength": 60 } }
        },
        "float_text": { "type": "string", "maxLength": 80 },
        "alt_buffer": { "type": "boolean" },
        "active_slot": { "type": "string", "pattern": "^[a-d]$" }
      }
    }
  }
}
